{
  "id": "/?source=pwa",
  "name": "EcoSwap 🌱 | Plataforma Comunitaria de Intercambio",
  "short_name": "EcoSwap",
  "description": "Plataforma comunitaria de economía circular: dale una segunda vida a tus objetos, gana EcoPuntos y mantén tu racha diaria.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
